# ==============================================================
# AgriSaarthi AI - Environment Configuration Example
# Copy this to server/.env or root .env as needed
# ==============================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agrisaarthi
JWT_SECRET=agrisaarthi_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# --- AI / LLM Configuration ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Government & Open Data Providers ---
# AGMARKNET data.gov.in API Key (Optional in Demo Mode)
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Providers Configuration ---
WEATHER_PROVIDER=open-meteo
SOIL_PROVIDER=isric-soilgrids

# --- Hackathon Resilience Mode ---
# When true, realistic offline/cached fallbacks for Maharashtra & crops are active if APIs or DB are unavailable
DEMO_MODE=true
